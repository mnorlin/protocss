{
  "name": "protocss",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:docs": "vite build",
    "build:css": "postcss src/styles/protocss/index.css -o dist/protocss.min.css",
    "format": "prettier --write ./src",
    "preview": "vite preview"
  },
  "devDependencies": {
    "cssnano": "^9.3.2",
    "fast-glob": "^3.3.3",
    "postcss": "^8.5.29",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.0",
    "prettier": "3.9.9",
    "prettier-plugin-css-order": "^2.2.0",
    "vite": "^8.3.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-css-order"
    ],
    "printWidth": 90
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "htmx.org": "^2.0.11",
    "lit": "^3.3.3",
    "modern-normalize": "^3.0.1",
    "vite-plugin-html-inject": "^1.1.2"
  }
